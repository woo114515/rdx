+    def get_receive_status(self):
+        """Return (thread_alive, last_byte_age, last_error)."""
+        with self.__state_lock:
+            thread = self.__receive_thread
+            age = None
+            if self.__last_receive_time is not None:
+                age = time.monotonic() - self.__last_receive_time
+            return bool(thread and thread.is_alive()), age, self.__receive_error
+
+    def get_report_age(self, report_type):
+        """Return monotonic age for a successfully parsed report type."""
+        with self.__state_lock:
+            report_time = self.__last_report_times.get(report_type)
+        return None if report_time is None else time.monotonic() - report_time
+
+    def __mark_report_received(self, report_type):
+        now = time.monotonic()
+        with self.__state_lock:
+            self.__last_receive_time = now
+            self.__last_report_times[report_type] = now
+            self.__receive_error = None
+
+    def __read_byte(self):
+        value = self.ser.read(1)
+        if not value:
+            raise TimeoutError("serial read timed out")
+        return value[0]
+
+    def __serial_write(self, command):
+        """Serialize writes and report short/failed writes to the caller."""
+        try:
+            payload = bytes(command)
+            with self.__write_lock:
+                written = self.ser.write(payload)
+            if written != len(payload):
+                raise serial.SerialTimeoutException(
+                    "short serial write: %d of %d bytes"
+                    % (written, len(payload))
+                )
+            return True
+        except (OSError, serial.SerialException) as error:
+            with self.__state_lock:
+                self.__receive_error = "serial write failed: %s" % error
+            if self.__debug:
+                print(self.__receive_error)
+            return False
+
 
