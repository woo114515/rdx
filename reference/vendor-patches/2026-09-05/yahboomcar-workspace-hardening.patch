+class YahboomcarDriver(Node):
+    """Bound serial I/O and publish only fresh controller feedback."""
+
+    def __init__(self, name):
+        super().__init__(name)
+        self._last_command = None
+        self._watchdog_stopped = True
+        self._shutting_down = False
+        self._started_at = time.monotonic()
+        self._last_encoder_counts = None
+        self._last_encoder_sample = None
+        self._bus = None
+        self._rgb_light_enabled = True
+        self._command_group = MutuallyExclusiveCallbackGroup()
+        self._watchdog_group = MutuallyExclusiveCallbackGroup()
+        self._feedback_group = MutuallyExclusiveCallbackGroup()
+
+        self._declare_parameters()
+        self._load_parameters()
+        self.car = SunriseRobot()
+        self.car.set_car_type(6)
+        if not self.car.create_receive_threading():
+            raise RuntimeError("failed to start serial receive thread")
+        if not self.stop_motion(3):
+            raise RuntimeError("failed to send startup stop command")
+
+        self.create_subscription(
+            Twist, self.motion_command_topic, self.cmd_vel_callback, 1,
+            callback_group=self._command_group,
+        )
+        self.create_subscription(Int32, "RGBLight", self.rgb_callback, 1)
+        self.create_subscription(Bool, "Buzzer", self.buzzer_callback, 10)
+        self.edition_publisher = self.create_publisher(Float32, "edition", 10)
+        self.voltage_publisher = self.create_publisher(Float32, "voltage", 10)
+        self.velocity_publisher = self.create_publisher(Twist, "vel_raw", 20)
+        self.stamped_velocity_publisher = self.create_publisher(
+            TwistStamped, "vel_raw_stamped", 20
+        )
+        self.imu_publisher = self.create_publisher(Imu, "imu/data_raw", 20)
+        self.mag_publisher = self.create_publisher(MagneticField, "imu/mag", 20)
+        self.encoder_publisher = self.create_publisher(
+            Int32MultiArray, "motor_encoder", 20
+        )
+        self.wheel_speed_publisher = self.create_publisher(
+            Float32MultiArray, "wheel_speed", 20
+        )
+        self.health_publisher = self.create_publisher(String, "driver_health", 10)
+        self.create_timer(
+            0.10, self.publish_feedback, callback_group=self._feedback_group
+        )
+        self.create_timer(
+            0.05, self.watchdog_callback, callback_group=self._watchdog_group
+        )
+
+    def _declare_parameters(self):
+        for key, value in {
+            "imu_link": "imu_link",
+            "xlinear_limit": 1.0,
+            "ylinear_limit": 1.0,
+            "angular_limit": 1.0,
+            "cmd_vel_timeout": 0.25,
+            "serial_report_timeout": 1.00,
+            "serial_startup_grace": 1.0,
+            "motion_command_topic": "/cmd_vel",
+        }.items():
+            self.declare_parameter(key, value)
+
+    def _load_parameters(self):
+        self.imu_link = str(self.get_parameter("imu_link").value)
+        self.xlinear_limit = float(self.get_parameter("xlinear_limit").value)
+        self.ylinear_limit = float(self.get_parameter("ylinear_limit").value)
+        self.angular_limit = float(self.get_parameter("angular_limit").value)
+        self.cmd_vel_timeout = float(self.get_parameter("cmd_vel_timeout").value)
+        self.serial_report_timeout = float(
+            self.get_parameter("serial_report_timeout").value
+        )
+        self.serial_startup_grace = float(
+            self.get_parameter("serial_startup_grace").value
+        )
+        self.motion_command_topic = str(
+            self.get_parameter("motion_command_topic").value
+        )
+        numeric = (
+            self.xlinear_limit, self.ylinear_limit, self.angular_limit,
+            self.cmd_vel_timeout, self.serial_report_timeout,
+            self.serial_startup_grace,
+        )
+        if not all(isfinite(value) and value > 0.0 for value in numeric):
+            raise ValueError("limits and timeouts must be finite and positive")
+        if not self.motion_command_topic.startswith("/"):
+            raise ValueError("motion_command_topic must be absolute")
+
+    def cmd_vel_callback(self, message):
+        try:
+            command = sanitize_motion(
+                message.linear.x, message.linear.y, message.angular.z,
+                self.xlinear_limit, self.ylinear_limit, self.angular_limit,
+            )
+        except ValueError as error:
+            self.get_logger().error(str(error))
+            self.stop_motion(3)
+            return
+        self._ensure_transport_healthy(require_feedback=False)
+        if not self.car.set_car_motion(*command):
+            raise RuntimeError("serial motion write failed")
+        self._last_command = time.monotonic()
+        self._watchdog_stopped = False
+
+    def stop_motion(self, repeat=1):
+        success = True
+        for _ in range(max(1, repeat)):
+            success = self.car.set_car_motion(0.0, 0.0, 0.0) and success
+        return success
+
+    def watchdog_callback(self):
+        if self._shutting_down:
+            return
+        self._ensure_transport_healthy(require_feedback=False)
+        if command_is_stale(
+            self._last_command, time.monotonic(), self.cmd_vel_timeout
+        ):
+            if not self._watchdog_stopped:
+                self.get_logger().warning(
+                    "cmd_vel timeout; commanding zero velocity"
+                )
+            if not self.stop_motion():
+                raise RuntimeError("watchdog failed to send zero velocity")
+            self._watchdog_stopped = True
+
+    @staticmethod
+    def _fresh(age, timeout):
+        return age is not None and 0.0 <= age <= timeout
+
+    @staticmethod
+    def _format_age(age):
+        return "missing" if age is None else "%.3f" % age
+
+    def _report_age(self, report_type):
+        return self.car.get_report_age(report_type)
+
+    def _ensure_transport_healthy(self, require_feedback=True):
+        alive, byte_age, error = self.car.get_receive_status()
+        grace = time.monotonic() - self._started_at <= self.serial_startup_grace
+        speed_age = self._report_age(self.car.FUNC_REPORT_SPEED)
+        encoder_age = self._report_age(self.car.FUNC_REPORT_ENCODER)
+        imu_ages = (
+            self._report_age(self.car.FUNC_REPORT_MPU_RAW),
+            self._report_age(self.car.FUNC_REPORT_ICM_RAW),
+        )
+        healthy = alive and (
+            grace or self._fresh(byte_age, self.serial_report_timeout)
+        )
+        feedback_fresh = (
+            self._fresh(speed_age, self.serial_report_timeout)
+            and self._fresh(encoder_age, self.serial_report_timeout)
+            and any(
+                self._fresh(age, self.serial_report_timeout)
+                for age in imu_ages
+            )
+        )
+        waiting_for_feedback = require_feedback and grace and not feedback_fresh
+        if require_feedback:
+            healthy = healthy and (feedback_fresh or waiting_for_feedback)
+        health = (
+            "healthy=%s;thread_alive=%s;byte_age=%s;speed_age=%s;"
+            "encoder_age=%s;error=%s"
+            % (
+                str(healthy).lower(), str(alive).lower(),
+                self._format_age(byte_age), self._format_age(speed_age),
+                self._format_age(encoder_age), error or "none",
+            )
+        )
+        if hasattr(self, "health_publisher"):
+            self.health_publisher.publish(String(data=health))
+        if not healthy:
+            return False
+        return not waiting_for_feedback
+
+    def _stamp_for_report(self, report_type):
+        age = self._report_age(report_type)
+        now = self.get_clock().now()
+        return now if age is None or age < 0.0 else now - Duration(seconds=age)
+
+    def publish_feedback(self):
+        if not self._ensure_transport_healthy(require_feedback=True):
+            return
+        speed_stamp = self._stamp_for_report(self.car.FUNC_REPORT_SPEED)
+        imu_type = self.car.FUNC_REPORT_ICM_RAW
+        if self._report_age(imu_type) is None:
+            imu_type = self.car.FUNC_REPORT_MPU_RAW
+        imu_stamp = self._stamp_for_report(imu_type)
+        encoder_age = self._report_age(self.car.FUNC_REPORT_ENCODER)
+        encoder_sample = time.monotonic() - (encoder_age or 0.0)
+
+        vx, vy, angular = self.car.get_motion_data()
+        twist = Twist()
+        twist.linear.x, twist.linear.y, twist.angular.z = vx, vy, angular
+        stamped = TwistStamped()
+        stamped.header.stamp = speed_stamp.to_msg()
+        stamped.header.frame_id = "base_footprint"
+        stamped.twist = twist
+
+        ax, ay, az = self.car.get_accelerometer_data()
+        gx, gy, gz = self.car.get_gyroscope_data()
+        mx, my, mz = self.car.get_magnetometer_data()
+        imu = Imu()
+        imu.header.stamp = imu_stamp.to_msg()
+        imu.header.frame_id = self.imu_link
+        imu.linear_acceleration.x, imu.linear_acceleration.y = -ax, az
+        imu.linear_acceleration.z = ay
+        imu.angular_velocity.x, imu.angular_velocity.y = -gx, gz
+        imu.angular_velocity.z = gy
+        mag = MagneticField()
+        mag.header = imu.header
+        mag.magnetic_field.x, mag.magnetic_field.y = mx, my
+        mag.magnetic_field.z = mz
+
+        counts = tuple(self.car.get_motor_encoder())
+        elapsed = 1.0
+        if self._last_encoder_sample is not None:
+            elapsed = encoder_sample - self._last_encoder_sample
+        rates = encoder_tick_rates(counts, self._last_encoder_counts, elapsed)
+        self._last_encoder_counts = counts
+        self._last_encoder_sample = encoder_sample
+
+        self.edition_publisher.publish(Float32(data=float(self.car.get_version())))
+        self.voltage_publisher.publish(
+            Float32(data=float(self.car.get_battery_voltage()))
+        )
+        self.velocity_publisher.publish(twist)
+        self.stamped_velocity_publisher.publish(stamped)
+        self.imu_publisher.publish(imu)
+        self.mag_publisher.publish(mag)
+        self.encoder_publisher.publish(Int32MultiArray(data=list(counts)))
+        self.wheel_speed_publisher.publish(Float32MultiArray(data=list(rates)))
+
+    def rgb_callback(self, message):
+        if self._bus is None:
+            self._bus = smbus.SMBus(0)
+        if message.data == 5:
+            value = 0 if self._rgb_light_enabled else 1
+            self._bus.write_byte_data(0x0D, 0x07, value)
+            self._rgb_light_enabled = not self._rgb_light_enabled
+        else:
+            self._bus.write_byte_data(0x0D, 0x04, message.data)
