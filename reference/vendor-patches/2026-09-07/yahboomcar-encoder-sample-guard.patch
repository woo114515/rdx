+def encoder_sample_interval(current_sample, previous_sample, minimum=0.001):
+    """Return elapsed time only when an encoder sample is genuinely newer."""
+    if not isfinite(current_sample):
+        return None
+    if previous_sample is None:
+        return 1.0
+    elapsed = current_sample - previous_sample
+    if not isfinite(elapsed) or elapsed < minimum:
+        return None
+    return elapsed
+
