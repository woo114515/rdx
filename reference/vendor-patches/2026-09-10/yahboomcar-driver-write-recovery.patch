+def test_cmd_vel_write_failure_logs_error_without_raising():
+    driver = FakeDriver(write_success=False)
+    message = Twist()
+    message.linear.x = 0.2
+
+    YahboomcarDriver.cmd_vel_callback(driver, message)
+
+    assert driver.car.commands == [(0.2, 0.0, 0.0)]
+    assert driver._last_command is None
+    assert driver._watchdog_stopped
+    assert len(driver.logger.errors) == 1
+    assert "motion command serial write failed" in driver.logger.errors[0]
+    assert "test failure" in driver.logger.errors[0]
+
