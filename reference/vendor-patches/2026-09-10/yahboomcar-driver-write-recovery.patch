                     "cmd_vel timeout; commanding zero velocity"
                 )
             if not self.stop_motion():
-                raise RuntimeError("watchdog failed to send zero velocity")
+                self._report_serial_write_failure("watchdog zero command")
+                self._watchdog_stopped = False
+                return
+            self._serial_write_failures = 0
             self._watchdog_stopped = True
 
+    def _report_serial_write_failure(self, operation):
+        """Report a failed write without terminating the ROS driver process."""
+        self._serial_write_failures += 1
+        alive, byte_age, error = self.car.get_receive_status()
+        self.get_logger().error(
+            "%s serial write failed; failure_count=%d;thread_alive=%s;"
+            "byte_age=%s;error=%s"
+            % (
+                operation,
+                self._serial_write_failures,
+                str(alive).lower(),
+                self._format_age(byte_age),
+                error or "unknown",
+            ),
+            throttle_duration_sec=1.0,
+        )
+
     @staticmethod
     def _fresh(age, timeout):
         return age is not None and 0.0 <= age <= timeout
