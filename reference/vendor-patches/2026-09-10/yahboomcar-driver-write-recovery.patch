+def test_watchdog_write_failure_logs_error_and_retries(monkeypatch):
+    driver = FakeDriver(write_success=False)
+    driver._last_command = 10.0
+    driver._watchdog_stopped = False
+    monkeypatch.setattr(Mcnamu_driver.time, "monotonic", lambda: 10.25)
+
+    YahboomcarDriver.watchdog_callback(driver)
+
+    assert driver.car.commands == [(0.0, 0.0, 0.0)]
