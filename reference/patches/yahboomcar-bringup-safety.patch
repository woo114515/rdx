+def sanitize_motion(vx, vy, angular, x_limit, y_limit, angular_limit):
+	values = (vx, vy, angular)
+	if not all(isfinite(value) for value in values):
+		raise ValueError('motion command must contain finite values')
+	return (
+		max(-x_limit, min(x_limit, vx)),
+		max(-y_limit, min(y_limit, vy)),
+		max(-angular_limit, min(angular_limit, angular)),
+	)
+
+def command_is_stale(last_cmd_time, now, timeout):
+	return last_cmd_time is None or now - last_cmd_time >= timeout
+
+def signed_encoder_delta(current, previous):
+	delta = (int(current) - int(previous)) & 0xffffffff
+	return delta - 0x100000000 if delta >= 0x80000000 else delta
+
+def encoder_tick_rates(current, previous, elapsed):
+	if elapsed <= 0.0:
+		raise ValueError('encoder sample interval must be positive')
+	if previous is None:
+		return (0.0, 0.0, 0.0, 0.0)
+	return tuple(
+		signed_encoder_delta(now_count, old_count) / elapsed
+		for now_count, old_count in zip(current, previous)
+	)
 
