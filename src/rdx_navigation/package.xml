<?xml version="1.0"?>
<package format="3">
  <name>rdx_navigation</name>
  <version>0.1.0</version>
  <description>SLAM mapping and static-map Nav2 launches for the RDX robot.</description>
  <maintainer email="maintainers@example.com">RDX Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rdx_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
